{
  "name": "crownicles_core",
  "version": "6.1.1",
  "description": "Core package of Crownicles which manages the game mechanics",
  "main": "src/main.js",
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "engines": {
    "node": ">=24.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "start": "pnpm run tsc && node dist/Core/src/main.js",
    "setup": "pnpm i",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm run tsc && vitest run --config vitest.integration.config.mts",
    "cd": "cd",
    "eslint": "eslint src",
    "eslintFix": "eslint src --fix",
    "tsc": "tsc",
    "dockerStart": "node --max-old-space-size=512 --heapsnapshot-signal=SIGUSR2 --diagnostic-dir=./logs dist/Core/src/main.js",
    "start-profiler": "pnpm run tsc && node --prof dist/Core/src/main.js"
  },
  "dependencies": {
    "@types/cls-hooked": "4.3.9",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "cls-hooked": "4.2.2",
    "cron": "4.4.0",
    "express": "5.2.1",
    "mariadb": "3.5.4",
    "moment": "2.30.1",
    "mqtt": "5.15.2",
    "prom-client": "15.1.3",
    "random-js": "2.1.0",
    "sequelize": "6.37.8",
    "source-map-support": "0.5.21",
    "toml": "5.0.0",
    "triple-beam": "1.4.1",
    "umzug": "3.8.3",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "winston-loki": "6.1.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/triple-beam": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "64.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "sequelize@6.37.8": "patches/sequelize@6.37.8.patch"
    }
  }
}
