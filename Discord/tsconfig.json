{
	"compilerOptions": {
		"module": "nodenext",
		"noImplicitAny": true,
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": true,
		"allowJs": true,
		"outDir": "dist",
		"rootDir": "..",
		"checkJs": false,
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"incremental": true,
		"noResolve": false,
		"noEmitOnError": false,
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"target": "es2024",
		"allowSyntheticDefaultImports": true,
		"types": [
			"node"
		],
		"lib": [
			"ES2022",
			"dom"
		],
		"strict": true
	},
	"include": [
		"src/**/*",
		"test/**/*",
		"../Lang/**/*.json",
		"../Lib/src/types/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"**/*.spec.ts"
	]
}