# These values are for `pnpm start` and simulators. The physical-device scripts compute their
# values at launch and must be used for a phone, otherwise Metro can be started without the same
# EXPO_PUBLIC_* values as the app.
#
# For iOS on Wi-Fi or USB tethering, use the Mac hostname (`<mac-name>.local`) rather than an IP.
# For Android over USB, use `pnpm start:android:usb` so adb reverse maps the local ports.
EXPO_PUBLIC_REST_API_URL=http://localhost:10500
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:10501
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=Crownicles
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=crownicles-app
