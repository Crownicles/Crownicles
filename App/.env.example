# On a simulator, localhost works as is.
#
# On a physical device, replace localhost by the machine name rather than by its IP address:
#   macOS   http://$(scutil --get LocalHostName).local:10500
#   Linux   http://$(hostname).local:10500      (needs avahi-daemon)
#   Windows http://$(hostname).local:10500      (needs Bonjour, shipped with iTunes)
# The name is resolved on the local network and survives an IP change, whereas an IP has to be
# updated here, in RestWs `callbackUrl` and in the Discord developer portal every time it moves.
EXPO_PUBLIC_REST_API_URL=http://localhost:10500
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:10501
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=Crownicles
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=crownicles-app
