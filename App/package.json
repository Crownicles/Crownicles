{
  "name": "crownicles",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:iphone": "zsh ./scripts/start-iphone.sh",
    "start:iphone:dev": "zsh ./scripts/start-iphone.sh --dev-client",
    "start:iphone:usb": "zsh ./scripts/start-iphone.sh --usb",
    "start:iphone:usb:dev": "zsh ./scripts/start-iphone.sh --usb --dev-client",
    "gamekit:prepare": "node ./scripts/gamekit-local.mjs prepare",
    "gamekit:metro": "node ./scripts/gamekit-local.mjs metro",
    "start:android": "zsh ./scripts/start-android.sh",
    "start:android:dev": "zsh ./scripts/start-android.sh --dev-client",
    "start:android:usb": "zsh ./scripts/start-android.sh --usb",
    "start:android:usb:dev": "zsh ./scripts/start-android.sh --usb --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-static|lucide-react-native|standard-navigation|ws-packets))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@twemoji/api": "17.0.3",
    "@twemoji/parser": "17.0.2",
    "buffer": "^6.0.3",
    "expo": "^58.0.23",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-game-center": "1.0.1",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^25.3.2",
    "lucide-react-native": "^1.49.0",
    "lucide-static": "^1.45.0",
    "markdown-it": "^15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-play-games": "0.4.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.3",
    "react-native-view-shot": "6.1.1",
    "react-native-volume-manager": "2.2.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "ws-packets": "link:../WsPackets"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.3.0",
    "@types/xml2js": "0.4.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-jsdoc": "64.2.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3",
    "xml2js": "0.6.2"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@^0.7": "^0.8.15"
    },
    "patchedDependencies": {
      "react-native-google-play-games@0.4.0": "patches/react-native-google-play-games@0.4.0.patch",
      "expo-game-center@1.0.1": "patches/expo-game-center@1.0.1.patch",
      "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view__masked-view@0.3.2.patch"
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
